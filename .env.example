NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by /ops for cross company counts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com
NEXT_PUBLIC_SITE_URL=https://noni-web.vercel.app

# Stripe. Server only, never expose to the client. When STRIPE_SECRET_KEY is
# empty in development, /admin/billing runs in a clearly marked simulated mode:
# checkout, top-ups and Connect write the same billing state without touching
# Stripe. Production requires every key below.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) for the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Safe to expose. Reserved for client-side Stripe.js flows.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring price ids: monthly bills $200/mo, annual bills $1,200/yr.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Connect OAuth client id (ca_...) for the read-only analytics connection.
STRIPE_CONNECT_CLIENT_ID=

# Server only. Powers Company Brain "Clean up with AI". Never expose to the client.
OPENAI_API_KEY=
