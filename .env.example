NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by /ops, billing, invites and /api/leads. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://noni-web.vercel.app

# Comma separated Google addresses that get the platform admin (ops) role on
# first sign in. See README "Platform admin access".
PLATFORM_ADMIN_EMAILS=

# Where people get the iPhone app. Pre-launch: the TestFlight public link
# (https://testflight.apple.com/join/XXXXXXXX). After launch: the App Store
# listing (https://apps.apple.com/app/idXXXXXXXXXX). Leave empty while
# neither exists: invite and onboarding screens then say a TestFlight invite
# is on its way and let people request one (stored in public.leads).
NEXT_PUBLIC_IOS_APP_URL=
# The Noni inbox behind Contact and Enterprise "Contact us". Leave empty and
# those open the lead form instead (stored in public.leads).
NEXT_PUBLIC_CONTACT_EMAIL=

# Stripe. Server only, never expose to the client. When STRIPE_SECRET_KEY is
# empty in development, /admin/billing runs in a clearly marked simulated mode:
# checkout, top-ups and Connect write the same billing state without touching
# Stripe. Production requires every key below.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) for the /api/stripe/webhook endpoint. Enable
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted and invoice.paid.
STRIPE_WEBHOOK_SECRET=
# Recurring price ids (design_handoff_pricing_plans, src/lib/plans.ts):
# Starter $100/mo monthly or $900/yr annual; Premium $250/mo monthly or
# $1,800/yr annual.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
# Connect OAuth client id (ca_...) for the optional read-only sales analytics
# connection. Without it, Connect is unavailable (fails closed); billing and
# plans work regardless.
STRIPE_CONNECT_CLIENT_ID=

# Server only. Powers Company Brain "Clean up with AI". Never expose to the client.
OPENAI_API_KEY=

# Development only. 1 serves the /admin QA mock dataset instead of the DB.
ADMIN_QA_MOCK=
